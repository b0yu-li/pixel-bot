OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=qwen/qwen3.5-plus-02-15

# Arize Phoenix local telemetry
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=pixel-bot-local
# Optional for Phoenix Cloud; leave empty for local
PHOENIX_API_KEY=

# Optional: live LLM evals (npm run test:eval). Requires OPENROUTER_API_KEY.
# RUN_LLM_EVAL=1 is set by npm scripts; omit for normal dev.

# Optional: cheap judge model for npm run test:eval:judge (ENABLE_LLM_JUDGE=1 in script).
# OPENROUTER_JUDGE_MODEL=qwen/qwen3-30b-a3b-instruct-2507

